{
  "name": "baochengview",
  "private": true,
  "version": "1.0.0",
  "description": "宝成铁路慢车沿线地图 - Baocheng Railway corridor map (Leaflet + Capacitor Android offline)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:android": "VITE_BASE=./ vite build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "seed-offline-tiles": "node scripts/download-offline-tiles.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.1.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
